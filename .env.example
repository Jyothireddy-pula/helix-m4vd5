# Copy to .env and fill in values

# Database (SQLite default for local dev; use PostgreSQL for production)
DATABASE_URL=sqlite+aiosqlite:///./data/wind_forecast.db
DATABASE_URL_SYNC=sqlite:///./data/wind_forecast.db

# For PostgreSQL (production):
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/windforecast
# DATABASE_URL_SYNC=postgresql://user:password@host:5432/windforecast

# Elexon API (no key required, public API)
ELEXON_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1
ELEXON_TIMEOUT_CONNECT=10.0
ELEXON_TIMEOUT_READ=60.0
ELEXON_MAX_RETRIES=3
ELEXON_CACHE_TTL_SECONDS=3600

# Analysis
DEFAULT_DECISION_CUTOFF_HOUR=16
DEFAULT_DECISION_CUTOFF_MINUTE=0

# CORS — use ["*"] to allow any origin (Render/Vercel), or restrict to specific origins
CORS_ORIGINS=["*"]
# CORS_ORIGINS=["http://localhost:5173","https://your-app.vercel.app"]

# Optional: protect the /ingestion/run endpoint
# INGESTION_SECRET=your-secret-here

# Frontend (set in frontend/.env.local for local dev)
# VITE_API_URL=http://localhost:8000
